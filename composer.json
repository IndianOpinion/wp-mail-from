{
    "name": "indianopinion/wp-mail-from",
    "description": "WordPress must-use plugin that sets a real From address, name and envelope sender on every wp_mail() message.",
    "type": "wordpress-muplugin",
    "license": "MIT",
    "keywords": ["wordpress", "wp_mail", "email", "from", "dmarc", "mu-plugin"],
    "homepage": "https://github.com/IndianOpinion/wp-mail-from",
    "support": {
        "issues": "https://github.com/IndianOpinion/wp-mail-from/issues",
        "source": "https://github.com/IndianOpinion/wp-mail-from"
    },
    "authors": [
        {
            "name": "Indian Opinion",
            "email": "hello@indianopinion.org"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "php-stubs/wp-cli-stubs": "^2.11",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.4",
        "squizlabs/php_codesniffer": "^3.10",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "IndianOpinion\\MailFrom\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IndianOpinion\\MailFrom\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "find src tests examples mu-loader *.php -name '*.php' -print0 | xargs -0 -n1 php -l",
        "phpcs": "phpcs",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "check": ["@lint", "@phpcs", "@phpstan", "@test"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "installer-name": "wp-mail-from"
    }
}
